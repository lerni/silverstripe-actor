{
  "name": "silverstripe-actor",
  "displayName": "Silverstripe Language Support",
  "description": "Silverstripe template language support with PHPActor integration",
  "version": "0.1.1",
  "publisher": "lerni",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lerni/silverstripe-actor"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "silverstripe",
    "template",
    "ss",
    "phpactor"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:silverstripe",
    "onStartupFinished"
  ],
  "contributes": {
    "languages": [
      {
        "id": "silverstripe",
        "aliases": [
          "Silverstripe",
          "silverstripe",
          "SS",
          "ss"
        ],
        "extensions": [
          ".ss"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "silverstripe",
        "scopeName": "text.html.silverstripe",
        "path": "./syntaxes/silverstripe.tmLanguage.json",
        "embeddedLanguages": {
          "source.js": "javascript",
          "source.css": "css"
        }
      },
      {
        "scopeName": "source.silverstripe.injection",
        "path": "./syntaxes/silverstripe-injection.tmLanguage.json",
        "injectTo": [
          "text.html.silverstripe",
          "source.css",
          "source.js"
        ]
      }
    ],
    "configurationDefaults": {
      "emmet.includeLanguages": {
        "silverstripe": "html"
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "lint": "biome check src/"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0"
  }
}
